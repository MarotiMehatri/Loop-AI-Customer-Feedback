{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "declaration": false
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "prisma/**/*.ts",
    "prisma.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/controllers/**/*",
    "src/repositories/**/*",
    "src/services/**/*",
    "src/jobs/**/*",
    "src/lib/**/*",
    "src/app/**/*"
  ]
}
