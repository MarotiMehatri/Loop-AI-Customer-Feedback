# =========================================================
# SERVER
# =========================================================

NODE_ENV=development
PORT=5000


# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=postgresql://username:password@localhost:5432/loop_db?schema=public


# =========================================================
# GOOGLE GEMINI
# =========================================================

GEMINI_API_KEY=your_gemini_api_key_here


# =========================================================
# JWT AUTHENTICATION
# =========================================================

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d


# =========================================================
# CORS / FRONTEND
# =========================================================
#
# You can specify one or multiple frontend origins.
#
# Local development:
# http://localhost:3000
#
# Production:
# https://loop-ai-platform.vercel.app
#
# Multiple origins:
# http://localhost:3000,https://loop-ai-platform.vercel.app
#

FRONTEND_URL=http://localhost:3000,https://loop-ai-customer-feedback-kfpn.vercel.app

# =========================================================
# EMAIL - OPTION A: SENDGRID
# =========================================================

SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# This address must be verified in SendGrid Sender Authentication.
MAIL_FROM=noreply@loop-platform.com
MAIL_FROM_NAME=LOOP AI Platform


# =========================================================
# EMAIL - OPTION B: SMTP
# =========================================================
#
# Example: Gmail SMTP
#
# If using SMTP instead of SendGrid, leave
# SENDGRID_API_KEY empty in your actual .env.
#

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=true