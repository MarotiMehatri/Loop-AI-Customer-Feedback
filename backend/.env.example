NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://username:password@localhost:5432/loop_db?schema=public

GEMINI_API_KEY=your_gemini_api_key_here

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
# During development (NODE_ENV=development) all origins are allowed.
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Option A: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# This address must be verified in SendGrid Sender Authentication.
MAIL_FROM=verified-sender@yourdomain.com
MAIL_FROM_NAME=LOOP AI Platform

# Option B: Any SMTP (e.g. Gmail). Enable by filling these; set SENDGRID_API_KEY empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_SECURE=true
