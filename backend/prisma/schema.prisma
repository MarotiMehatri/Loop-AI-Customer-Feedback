generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
  ARCHIVED
}

enum FeedbackChannel {
  SUPPORT
  APP_STORE
  SURVEY
  SALES
  SOCIAL
  WEBSITE
  EMAIL
  MANUAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum ThemeStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  feedbacks       Feedback[]
  feedbackImports FeedbackImport[]
  notifications   Notification[]
  reports         Report[]

  themes          Theme[]
  conversations   Conversation[]
  reportTemplates ReportTemplate[]

  workspaceInvites WorkspaceInvite[]
  settings         WorkspaceSettings?
  activityLogs     ActivityLog[]

  savedViews   SavedView[]
  dataSources  DataSource[]
  exportJobs   ExportJob[]

  @@index([name])
  @@index([createdAt])
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(VIEWER)
  avatarUrl    String?

  phone      String?
  bio        String? @db.Text
  jobTitle   String?
  department String?
  location   String?
  timezone   String? @default("Asia/Kolkata")

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  notifications Notification[]
  reports       Report[]

  createdFeedback  Feedback[] @relation("FeedbackCreatedBy")
  assignedFeedback Feedback[] @relation("FeedbackAssignedTo")

  feedbackImports    FeedbackImport[]
  conversations      Conversation[]
  aimessageFeedbacks AIMessageFeedback[]
  reportTemplates    ReportTemplate[]
  reportExports      ReportExport[]

  preferences  UserPreference?
  activityLogs ActivityLog[]

  createdWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInviteCreator")

  createdSavedViews  SavedView[]
  createdDataSources DataSource[]
  createdExportJobs  ExportJob[]

  @@index([workspaceId])
  @@index([workspaceId, role])
  @@index([workspaceId, isActive])
  @@index([workspaceId, createdAt])
}

model Feedback {
  id String @id @default(cuid())

  // Feedback source and classification
  source    FeedbackChannel
  sentiment Sentiment       @default(NEUTRAL)
  status    FeedbackStatus  @default(NEW)

  // Customer information
  customerName   String?
  customerEmail  String?
  customerAvatar String?

  // Main feedback content
  content String @db.Text

  // Optional feedback details
  subject  String?
  category String?
  tags     String[] @default([])

  // External platform information
  externalId  String?
  externalUrl String?

  // Rating for reviews, surveys, or app stores
  rating Int?

  // Language detected from feedback
  language String? @default("en")

  // Feedback Inbox flags
  isImportant Boolean @default(false)
  isRead      Boolean @default(false)
  isPinned    Boolean @default(false)

  // AI classification fields
  isClassified  Boolean   @default(false)
  aiSummary     String?   @db.Text
  aiCategory    String?
  aiConfidence  Float?
  aiProcessedAt DateTime?

  // Additional provider-specific data
  metadata Json?

  // Workspace relation
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // User who created/imported feedback
  createdById String

  createdBy User @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Analyst assigned to feedback
  assignedToId String?

  assignedTo User? @relation("FeedbackAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Dates
  feedbackDate   DateTime?
  reviewedAt     DateTime?
  actionedAt     DateTime?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  feedbackThemes FeedbackTheme[]

  // Prevent duplicate imported feedback
  @@unique([workspaceId, source, externalId])
  // Feedback Inbox filters
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, category])
  @@index([workspaceId, isImportant])
  @@index([workspaceId, isRead])
  @@index([workspaceId, isPinned])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, sentiment, status])
  @@index([workspaceId, source, sentiment])
  @@index([createdById])
  @@index([assignedToId])
}

model FeedbackImport {
  id           String @id @default(cuid())
  fileName     String
  originalName String
  fileType     String
  fileSize     Int

  status ImportStatus @default(PENDING)

  totalRows      Int     @default(0)
  successfulRows Int     @default(0)
  failedRows     Int     @default(0)
  duplicateRows  Int     @default(0)
  skippedRows    Int     @default(0)
  errorMessage   String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  workspaceId  String
  importedById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  importedBy User @relation(fields: [importedById], references: [id], onDelete: Cascade)

  errors FeedbackImportError[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([importedById])
  @@index([workspaceId, status])
  @@index([createdAt])
}

model FeedbackImportError {
  id String @id @default(cuid())

  rowNumber Int
  field     String?

  rawValue String?
  rawData  Json?

  errorCode    String?
  errorMessage String  @db.Text

  feedbackImportId String

  feedbackImport FeedbackImport @relation(fields: [feedbackImportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([feedbackImportId])
  @@index([feedbackImportId, rowNumber])
  @@index([createdAt])
}

model Theme {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  status        ThemeStatus @default(ACTIVE)
  color         String?
  isAiGenerated Boolean     @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackThemes FeedbackTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model FeedbackTheme {
  id         String  @id @default(cuid())
  confidence Float?
  isPrimary  Boolean @default(false)

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([feedbackId, themeId])
  @@index([feedbackId])
  @@index([themeId])
}

model Conversation {
  id          String @id @default(uuid())
  workspaceId String
  userId      String
  title       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages ConversationMessage[]

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, userId])
  @@index([workspaceId, userId, updatedAt])
}

model ConversationMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text

  chart    Json?
  metadata Json?

  promptTokens     Int?
  completionTokens Int?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userFeedback AIMessageFeedback[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

model AIMessageFeedback {
  id        String  @id @default(uuid())
  messageId String
  userId    String
  helpful   Boolean
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// Reports

enum ReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
  SCHEDULED
}

enum ReportType {
  VOICE_OF_CUSTOMER
  INSIGHTS
  ANALYTICS
  SUMMARY
  SENTIMENT
  THEMES
  CUSTOM
}

enum ReportExportFormat {
  PDF
  CSV
  XLSX
}

model Report {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        ReportType
  status      ReportStatus @default(DRAFT)

  startDate DateTime?
  endDate   DateTime?

  // Selected feedback sources:
  // SUPPORT, APP_STORE, SURVEY, SALES, SOCIAL, etc.
  sources Json?

  // Filters and segments selected in step 2
  filters Json?

  // Metrics selected in step 3
  metrics Json?

  // Chart and visual configuration
  charts Json?

  // Final generated report data
  data Json?

  // Gemini-generated report summary
  aiSummary String?

  // Optional report tags
  tags String[]

  generatedAt DateTime?
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  templateId String?
  template   ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  exports  ReportExport[]
  schedule ScheduledReport?

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([userId])
}

model ReportTemplate {
  id          String     @id @default(cuid())
  name        String
  description String?
  type        ReportType

  sources Json?
  filters Json?
  metrics Json?
  charts  Json?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  reports Report[]

  @@index([workspaceId])
  @@index([workspaceId, type])
}

model ReportExport {
  id           String             @id @default(cuid())
  format       ReportExportFormat
  fileName     String
  fileUrl      String
  fileSize     Int?
  downloadedAt DateTime?
  createdAt    DateTime           @default(now())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([createdAt])
}

model ScheduledReport {
  id             String   @id @default(cuid())
  frequency      String
  cronExpression String?
  recipients     String[]
  isActive       Boolean  @default(true)

  nextRunAt DateTime?
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([nextRunAt])
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model WorkspaceInvite {
  id         String                @id @default(cuid())
  email      String
  role       Role                  @default(VIEWER)
  tokenHash  String                @unique
  status     WorkspaceInviteStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("WorkspaceInviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email, status])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([email])
  @@index([expiresAt])
}

enum UserTheme {
  LIGHT
  DARK
  SYSTEM
}

enum Language {
  ENGLISH
  HINDI
}

model UserPreference {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailNotifications  Boolean @default(true)
  pushNotifications   Boolean @default(true)
  reportNotifications Boolean @default(true)
  weeklySummary       Boolean @default(true)

  theme    UserTheme @default(SYSTEM)
  language Language  @default(ENGLISH)

  timezone String @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ActivityType {
  LOGIN
  LOGOUT

  PROFILE_UPDATED
  PASSWORD_CHANGED
  AVATAR_UPDATED
  PREFERENCES_UPDATED

  MEMBER_INVITED
  MEMBER_UPDATED
  MEMBER_ROLE_CHANGED
  MEMBER_STATUS_CHANGED
  MEMBER_REMOVED

  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_DELETED

  FEEDBACK_CREATED
  FEEDBACK_UPDATED
  FEEDBACK_DELETED
  FEEDBACK_IMPORTED
  FEEDBACK_ASSIGNED

  THEME_CREATED
  THEME_UPDATED
  THEME_DELETED
  THEME_GENERATED

  REPORT_CREATED
  REPORT_UPDATED
  REPORT_GENERATED
  REPORT_EXPORTED
  REPORT_DELETED

  SETTINGS_UPDATED

  NOTIFICATION_READ
  NOTIFICATIONS_CLEARED

  ASK_LOOP_QUESTION
  DATA_EXPORTED
}

model ActivityLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  type ActivityType

  title String

  description String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
}

enum NotificationType {
  SYSTEM

  REPORT_CREATED
  REPORT_COMPLETED
  REPORT_FAILED
  REPORT_EXPORTED

  FEEDBACK_CREATED
  FEEDBACK_ASSIGNED
  FEEDBACK_IMPORTED

  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED

  WORKSPACE_UPDATED
  SETTINGS_UPDATED

  SECURITY_ALERT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id       String               @id @default(cuid())
  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  title   String
  message String @db.Text

  isRead Boolean   @default(false)
  readAt DateTime?

  entityType String?
  entityId   String?

  metadata Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([userId, workspaceId])
  @@index([userId, workspaceId, isRead])
  @@index([workspaceId, type])
  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model WorkspaceSettings {
  id String @id @default(cuid())

  general       Json
  ai            Json
  feedback      Json
  reports       Json
  security      Json
  retention     Json
  notifications Json

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

enum DataSourceType {
  API
  WEBHOOK
  CSV
  DATABASE
  EMAIL
  SOCIAL_MEDIA
  CUSTOM
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
}

enum ExportFormat {
  CSV
  XLSX
  JSON
  PDF
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model SavedView {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  filters     Json
  isDefault   Boolean @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, createdById])
  @@index([createdAt])
}

model DataSource {
  id          String         @id @default(cuid())
  name        String
  type        DataSourceType
  description String?        @db.Text
  config      Json
  isActive    Boolean        @default(true)
  status      DataSourceStatus @default(INACTIVE)

  lastSyncAt DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@index([createdAt])
}

model ExportJob {
  id       String       @id @default(cuid())
  name     String
  format   ExportFormat
  type     String
  status   ExportJobStatus @default(PENDING)
  filters  Json?
  filePath String?
  fileSize Int?
  error    String?      @db.Text

  completedAt DateTime?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, format])
  @@index([createdAt])
}
