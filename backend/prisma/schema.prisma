generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
  ARCHIVED
}

enum FeedbackChannel {
  SUPPORT
  APP_STORE
  SURVEY
  SALES
  SOCIAL
  WEBSITE
  EMAIL
  MANUAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum NotificationType {
  DAILY_SUMMARY
  DELIVERY_ALERT
  FAILED_DELIVERY
  SYSTEM
  REPORT_READY
}

enum ThemeStatus {
  ACTIVE
  ARCHIVED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  feedbacks       Feedback[]
  feedbackImports FeedbackImport[]
  notifications   Notification[]
  reports         Report[]

  themes Theme[]

  @@index([name])
  @@index([createdAt])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  notifications Notification[]
  reports       Report[]

  createdFeedback  Feedback[] @relation("FeedbackCreatedBy")
  assignedFeedback Feedback[] @relation("FeedbackAssignedTo")

  feedbackImports FeedbackImport[]

  @@index([workspaceId])
  @@index([workspaceId, role])
  @@index([workspaceId, isActive])
  @@index([workspaceId, createdAt])
}

model Feedback {
  id String @id @default(cuid())

  // Feedback source and classification
  source    FeedbackChannel
  sentiment Sentiment       @default(NEUTRAL)
  status    FeedbackStatus  @default(NEW)

  // Customer information
  customerName   String?
  customerEmail  String?
  customerAvatar String?

  // Main feedback content
  content String @db.Text

  // Optional feedback details
  subject  String?
  category String?
  tags     String[] @default([])

  // External platform information
  externalId  String?
  externalUrl String?

  // Rating for reviews, surveys, or app stores
  rating Int?

  // Language detected from feedback
  language String? @default("en")

  // Feedback Inbox flags
  isImportant Boolean @default(false)
  isRead      Boolean @default(false)
  isPinned    Boolean @default(false)

  // AI classification fields
  isClassified  Boolean   @default(false)
  aiSummary     String?   @db.Text
  aiCategory    String?
  aiConfidence  Float?
  aiProcessedAt DateTime?

  // Additional provider-specific data
  metadata Json?

  // Workspace relation
  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // User who created/imported feedback
  createdById String

  createdBy User @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Analyst assigned to feedback
  assignedToId String?

  assignedTo User? @relation("FeedbackAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Dates
  feedbackDate   DateTime?
  reviewedAt     DateTime?
  actionedAt     DateTime?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  feedbackThemes FeedbackTheme[]

  // Prevent duplicate imported feedback
  @@unique([workspaceId, source, externalId])
  // Feedback Inbox filters
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, category])
  @@index([workspaceId, isImportant])
  @@index([workspaceId, isRead])
  @@index([workspaceId, isPinned])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, sentiment, status])
  @@index([workspaceId, source, sentiment])
  @@index([createdById])
  @@index([assignedToId])
}

model FeedbackImport {
  id           String @id @default(cuid())
  fileName     String
  originalName String
  fileType     String
  fileSize     Int

  status ImportStatus @default(PENDING)

  totalRows      Int     @default(0)
  successfulRows Int     @default(0)
  failedRows     Int     @default(0)
  duplicateRows  Int     @default(0)
  skippedRows    Int     @default(0)
  errorMessage   String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  workspaceId  String
  importedById String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  importedBy User @relation(fields: [importedById], references: [id], onDelete: Cascade)

  errors FeedbackImportError[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([importedById])
  @@index([workspaceId, status])
  @@index([createdAt])
}

model FeedbackImportError {
  id String @id @default(cuid())

  rowNumber Int
  field     String?

  rawValue String?
  rawData  Json?

  errorCode    String?
  errorMessage String  @db.Text

  feedbackImportId String

  feedbackImport FeedbackImport @relation(fields: [feedbackImportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([feedbackImportId])
  @@index([feedbackImportId, rowNumber])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, type])
}

model Report {
  id        String    @id @default(cuid())
  title     String
  type      String
  data      Json?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, type])
}

model Theme {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  status        ThemeStatus @default(ACTIVE)
  color         String?
  isAiGenerated Boolean     @default(false)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackThemes FeedbackTheme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model FeedbackTheme {
  id         String  @id @default(cuid())
  confidence Float?
  isPrimary  Boolean @default(false)

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([feedbackId, themeId])
  @@index([feedbackId])
  @@index([themeId])
}
