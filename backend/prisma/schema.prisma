generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
  ARCHIVED
}

enum FeedbackChannel {
  SUPPORT
  APP_STORE
  SURVEY
  SALES
  SOCIAL
  WEBSITE
  EMAIL
  MANUAL
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  feedbacks Feedback[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdFeedback Feedback[] @relation("FeedbackCreatedBy")

  @@index([workspaceId])
  @@index([workspaceId, role])
  @@index([workspaceId, isActive])
}

model Feedback {
  id String @id @default(cuid())

  source    FeedbackChannel
  sentiment Sentiment
  status    FeedbackStatus  @default(NEW)

  customerName  String?
  customerEmail String?

  content String @db.Text

  tags        String[] @default([])
  category    String?
  isImportant Boolean  @default(false)

  metadata Json?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, isImportant])
  @@index([workspaceId, createdAt])
  @@index([createdById])
}
