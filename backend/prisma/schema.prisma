generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
  ARCHIVED
}

enum FeedbackChannel {
  SUPPORT
  APP_STORE
  SURVEY
  SALES
  SOCIAL
  WEBSITE
  EMAIL
  MANUAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum NotificationType {
  DAILY_SUMMARY
  DELIVERY_ALERT
  FAILED_DELIVERY
  SYSTEM
  REPORT_READY
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  feedbacks       Feedback[]
  feedbackImports FeedbackImport[]
  notifications   Notification[]
  reports         Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  notifications Notification[]
  reports       Report[]

  createdFeedback Feedback[]       @relation("FeedbackCreatedBy")
  feedbackImports FeedbackImport[]

  @@index([workspaceId])
  @@index([workspaceId, role])
  @@index([workspaceId, isActive])
}

model Feedback {
  id String @id @default(cuid())

  source    FeedbackChannel
  sentiment Sentiment
  status    FeedbackStatus  @default(NEW)

  customerName  String?
  customerEmail String?

  content String @db.Text

  tags        String[] @default([])
  category    String?
  isImportant Boolean  @default(false)

  metadata Json?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, isImportant])
  @@index([workspaceId, createdAt])
  @@index([createdById])
}

model FeedbackImport {
  id           String @id @default(cuid())
  fileName     String
  originalName String
  fileType     String
  fileSize     Int

  status ImportStatus @default(PENDING)

  totalRows      Int @default(0)
  successfulRows Int @default(0)
  failedRows     Int @default(0)
  duplicateRows  Int @default(0)

  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  workspaceId  String
  importedById String

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importedBy User      @relation(fields: [importedById], references: [id], onDelete: Cascade)

  errors FeedbackImportError[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([importedById])
  @@index([workspaceId, status])
  @@index([createdAt])
}

model FeedbackImportError {
  id           String  @id @default(cuid())
  rowNumber    Int
  field        String?
  rawData      Json?
  errorMessage String

  feedbackImportId String
  feedbackImport   FeedbackImport @relation(fields: [feedbackImportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([feedbackImportId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, type])
}

model Report {
  id        String    @id @default(cuid())
  title     String
  type      String
  data      Json?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, type])
}
