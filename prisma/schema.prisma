// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

enum FeedbackChannel {
  SUPPORT
  APP_STORE
  SURVEY
  SALES
  SOCIAL
  MANUAL
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  feedback Feedback[]
  themes   Theme[]
  reports  Report[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  workspaceId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  reports Report[] @relation("GeneratedReports")

  @@index([workspaceId])
  @@index([workspaceId, role])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String          @db.Text
  channel        FeedbackChannel
  sourceRef      String?
  customerLabel  String?
  featureArea    String?
  rationale      String?         @db.Text
  sentiment      Sentiment?
  sentimentScore Float?
  status         FeedbackStatus  @default(NEW)
  requiresReview Boolean         @default(false)
  workspaceId    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackThemes FeedbackTheme[]
  embedding      Embedding?

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, channel])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, status])
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  color       String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackThemes FeedbackTheme[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
  @@index([themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id            String   @id @default(cuid())
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  contentJson   Json
  workspaceId   String
  generatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  generatedBy User @relation("GeneratedReports", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([generatedById])
}
